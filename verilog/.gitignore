# ==========================================================================
# Platform Designer (Qsys) Processing Space
# ==========================================================================
# Ignore all generated Qsys directories...
# ==========================================================================
# Platform Designer (Qsys) Processing Space
# ==========================================================================
# Ignore the CONTENTS of any soc_system folder so Git still climbs inside to check rules
**/soc_system/*

# Explicitly whitelist the two files required for structural synthesis
!**/soc_system/synthesis/soc_system.qip
!**/soc_system/synthesis/soc_system.v
